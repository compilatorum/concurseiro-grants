{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compilatorum.github.io/concurseiro-grants/schemas/funding-opportunity.schema.json",
  "title": "GrantOSFundingOpportunity",
  "type": "object",
  "required": ["id", "funder", "program", "mechanism", "status", "source_url", "checked_at", "fit_projects"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "funder": {"type": "string", "minLength": 1},
    "program": {"type": "string", "minLength": 1},
    "mechanism": {"enum": ["MILESTONE_GRANT", "RFP", "RESEARCH_GRANT", "RETROACTIVE_FUNDING", "QUADRATIC_FUNDING", "BOUNTY", "CROWDFUNDING", "HACKATHON", "ACCELERATOR", "INVESTMENT", "CUSTOMER_REVENUE"]},
    "status": {"enum": ["OPEN", "UPCOMING", "ROLLING", "PAUSED", "CLOSED", "UNKNOWN"]},
    "source_url": {"type": "string", "format": "uri"},
    "checked_at": {"type": "string", "format": "date-time"},
    "deadline": {"type": ["string", "null"], "format": "date-time"},
    "geography": {"type": "array", "items": {"type": "string"}},
    "ecosystems": {"type": "array", "items": {"type": "string"}},
    "ticket_min": {"type": ["number", "null"], "minimum": 0},
    "ticket_max": {"type": ["number", "null"], "minimum": 0},
    "currency": {"type": ["string", "null"]},
    "eligibility_notes": {"type": "string"},
    "restrictions": {"type": "array", "items": {"type": "string"}},
    "fit_projects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "fit_score": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "owner": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}